 "provenance": {
  "source": "wx2 (legacy MSSQL 127.0.0.1:11433, database wx2), 只读 SELECT",
  "sql": "SELECT p.TRADE_DT AS trade_date, p.S_INFO_WINDCODE AS index_code, p.S_DQ_PCTCHANGE AS pct_change FROM wx2.dbo.AINDEXEODPRICES p WITH (NOLOCK) WHERE p.TRADE_DT BETWEEN %s AND %s AND p.S_INFO_WINDCODE IN (%s, %s) ORDER BY p.TRADE_DT, p.S_INFO_WINDCODE",
