# QuantAgent 配置模板。复制为 .env 后填写，.env 永不入库。
#
# 旧仓的做法是把 config.ini 软链到 ~/.dbconfig/config.ini，里面是明文密码，
# 且没有 dev/prod 切换机制。新仓改为：环境变量 + QUANTAGENT_PROFILE 切换，
# 由 pydantic-settings 解析和校验，缺失即启动失败（fail-closed）。

# ---------------------------------------------------------------------------
# 环境档位。local 为本机开发镜像库，office 为公司主库。
# 两套环境的差别只体现在连接参数和 lake 根路径，代码路径完全一致。
# ---------------------------------------------------------------------------
QUANTAGENT_PROFILE=local

# ---------------------------------------------------------------------------
# PostgreSQL 研究数据面（src_* schema，只有 ingest 层写）
# psycopg3，不再需要 ODBC / JDBC / JVM
# ---------------------------------------------------------------------------
QUANTAGENT_PG_SRC_HOST=127.0.0.1
QUANTAGENT_PG_SRC_PORT=5432
QUANTAGENT_PG_SRC_DATABASE=quantagent
QUANTAGENT_PG_SRC_USER=
QUANTAGENT_PG_SRC_PASSWORD=

# ---------------------------------------------------------------------------
# PostgreSQL 控制状态面（ops_* schema + Dagster 运行存储）
# 可与研究数据面同实例不同 schema；研究查询禁止读取这里
# ---------------------------------------------------------------------------
QUANTAGENT_PG_OPS_HOST=127.0.0.1
QUANTAGENT_PG_OPS_PORT=5432
QUANTAGENT_PG_OPS_DATABASE=quantagent_ops
QUANTAGENT_PG_OPS_USER=
QUANTAGENT_PG_OPS_PASSWORD=

# ---------------------------------------------------------------------------
# 本地可变状态根目录。所有 Parquet、缓存、日志、运行制品都在这下面。
# 相对路径相对仓库根解析；不允许代码里出现任何写死的绝对路径。
# ---------------------------------------------------------------------------
QUANTAGENT_VAR_ROOT=var

# ---------------------------------------------------------------------------
# 写库总闸。默认关闭：必须显式置为 true 且命令行显式传 --write-db 才真写。
# 见 AGENTS.md 数据安全铁律。
# ---------------------------------------------------------------------------
QUANTAGENT_ALLOW_DB_WRITE=false

# ---------------------------------------------------------------------------
# 外部数据源凭据
# ---------------------------------------------------------------------------
QUANTAGENT_TUSHARE_TOKEN=
QUANTAGENT_FRED_API_KEY=

# Wind 只读源。读 wind_db，不读 wx2。历史回填与日更共用同一分页作业。
QUANTAGENT_WIND_MSSQL_HOST=
QUANTAGENT_WIND_MSSQL_PORT=1433
QUANTAGENT_WIND_MSSQL_DATABASE=wind_db
QUANTAGENT_WIND_MSSQL_USER=
QUANTAGENT_WIND_MSSQL_PASSWORD=

# 旧 SQL Server wx2，仅在 P2 迁移期作为只读源使用，迁移完成后删除本段
QUANTAGENT_LEGACY_MSSQL_HOST=
QUANTAGENT_LEGACY_MSSQL_PORT=1433
QUANTAGENT_LEGACY_MSSQL_DATABASE=wx2
QUANTAGENT_LEGACY_MSSQL_USER=
QUANTAGENT_LEGACY_MSSQL_PASSWORD=
